{
  "name": "rambam-daily",
  "version": "1.1.0",
  "description": "רמב\"ם יומי - macOS Menu Bar App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac dmg",
    "build:stage": "STAGE=true electron-builder --mac dmg",
    "build:prod": "rm -rf dist && electron-builder --mac dmg",
    "release": "npm run build:prod && mkdir -p release && cp dist/*.dmg release/"
  },
  "build": {
    "appId": "com.moshe.rambam-daily",
    "productName": "רמב\"ם יומי",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "assets/**",
      "node_modules/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "רמב\"ם יומי",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 220,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^24.13.3"
  },
  "author": "Moshe",
  "license": "MIT"
}
